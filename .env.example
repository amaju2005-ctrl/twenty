# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEMO_MODE=true

# Supabase (database + authentication)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI drafting
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Gmail OAuth (use /api/gmail/callback as the redirect URI)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 32-byte base64 key used to encrypt Gmail refresh tokens
# Generate with: openssl rand -base64 32
APP_ENCRYPTION_KEY=
CRON_SECRET=

# Hunter powers masked professional discovery and selective work-email reveal.
# Keep provider keys server-only. Never prefix them with NEXT_PUBLIC_.
HUNTER_API_KEY=

# Optional alternative discovery provider (not required)
PEOPLE_DATA_LABS_API_KEY=
